    "raw_output": "pub fn parse_quoted_list(s: &str) -> Option<Vec<String>> {\n    if s.is_empty() {\n        return Some(vec![]);\n    }\n\n    let mut result = Vec::new();\n    let mut i = 0;\n    let len = s.len();\n\n    while i < len {\n        let mut start = i;\n        let mut in_quote = false;\n        let mut chars = s.chars().peekable();\n\n        while let Some(c) = chars.next() {\n            if c == '\"' {\n                if in_quote {\n                    if chars.peek() == Some(&'\\\"') {\n                        chars.next(); // skip the second quote\n                    } else {\n                        break; // malformed: single closing quote\n                    }\n                } else {\n                    in_quote = true;\n                }\n            } else if c == ',' && !in_quote {\n                break; // unquoted comma\n            }\n            i += 1;\n        }\n\n        let field = &s[start..i];\n        if !field.is_empty() {\n            if !field.chars().all(|c| c == '\"') {\n                return None; // unquoted text\n            }\n            let field = field.trim();\n            if field.is_empty() {\n                result.push(\"\");\n            } else {\n                result.push(field.replace('\"', \"\\\"\"));\n            }\n        }\n    }\n\n    Some(result)\n}<|im_end|>",
