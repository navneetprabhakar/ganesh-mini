    "raw_output": "import java.util.*;public final class Solution{public static List<String> resolvePermissions(String role, Map<String,String> parents, Map<String,List<String>> grants){if(!parents.containsKey(role)){throw new IllegalArgumentException(\"Unknown role: \" + role);}if(!parents.containsKey(role)){throw new IllegalArgumentException(\"Unknown parent reached: \" + role);}if(grants.containsKey(role)){return new ArrayList<>(grants.get(role));}List<String> result = new ArrayList<>();for(String parent : parents.keySet()){if(parent.equals(role)){continue;}if(!parents.containsKey(parent)){throw new IllegalArgumentException(\"Unknown parent reached: \" + parent);}result.addAll(resolvePermissions(parent, parents, grants));}Collections.sort(result);return result;}}<|im_end|>",
