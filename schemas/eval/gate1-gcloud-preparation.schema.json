{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-gate1-gcloud-preparation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "gate",
    "purpose",
    "model",
    "resource_proposal",
    "public_price_bound",
    "utilization",
    "local_inputs",
    "reused_generation_pinned_inputs",
    "lifecycle",
    "hard_stops",
    "failed_checks",
    "preparation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ganesh-mini-gate1-gcloud-preparation/v1"},
    "status": {"const": "prepared-not-executable"},
    "gate": {"const": 1},
    "purpose": {"type": "string"},
    "model": {"type": "object"},
    "resource_proposal": {"type": "object"},
    "public_price_bound": {"type": "object"},
    "utilization": {"type": "object"},
    "local_inputs": {"type": "object"},
    "reused_generation_pinned_inputs": {"type": "object"},
    "lifecycle": {"type": "array", "items": {"type": "string"}},
    "hard_stops": {"type": "array", "items": {"type": "string"}},
    "failed_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preparation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
