  "extraction": {
    "extracted_code": "export function ringBufferTrace(capacity: number, values: readonly number[]): number[] | null {\n  if (capacity <= 0) {\n    return null;\n  }\n  if (values.length === 0) {\n    return [];\n  }\n  if (values.some(v => v === -1)) {\n    return null;\n  }\n\n  const result: number[] = [];\n  const head = 0;\n  const tail = 0;\n  const capacityLimit = capacity;\n\n  for (const value of values) {\n    if (head === tail) {\n      // No space available, emit -1\n      result.push(-1);\n      head = (head + 1) % capacityLimit;\n      tail = (tail + 1) % capacityLimit;\n    } else {\n      // Evict oldest\n      result.push(values[head]);\n      head = (head + 1) % capacityLimit;\n    }\n  }\n\n  // Emit remaining values\n  while (head < tail) {\n    result.push(values[head]);\n    head = (head + 1) % capacityLimit;\n  }\n\n  return result;\n}\n",
    "extracted_code_sha256": "5778081f08d1d8716d2a70e65d15dfb2619e3a189ed5ce29dddbc9e61afebc6d",
