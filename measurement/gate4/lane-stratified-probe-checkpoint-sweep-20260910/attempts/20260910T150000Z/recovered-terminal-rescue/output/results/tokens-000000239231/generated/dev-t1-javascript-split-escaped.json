    "raw_output": "const splitEscaped = (x) => {\n  if (typeof x !== 'string') return null;\n  const result = [];\n  let i = 0;\n  while (i < x.length) {\n    if (x[i] === '\\\\') {\n      i++;\n      if (i >= x.length) return null;\n      const c = x[i];\n      if (c === ',') {\n        result.push('');\n        i++;\n      } else if (c === '\\\\') {\n        i++;\n        if (i >= x.length) return null;\n        const next = x[i];\n        if (next === ',') {\n          result.push('');\n          i++;\n        } else if (next === '\\\\') {\n          i++;\n          if (i >= x.length) return null;\n          const next2 = x[i];\n          if (next2 === ',') {\n            result.push('');\n            i++;\n          } else if (next2 === '\\\\') {\n            i++;\n            if (i >= x.length) return null;\n            const next3 = x[i];\n            if (next3 === ',') {\n              result.push('');\n              i++;\n            } else {\n              result.push(x.slice(i, i + 2));\n              i += 2;\n            }\n          } else {\n            result.push(x.slice(i, i + 1));\n            i++;\n          }\n        } else {\n          result.push(x.slice(i, i + 1));\n          i++;\n        }\n      } else {\n        result.push(x.slice(i, i + 1));\n        i++;\n      }\n    } else {\n      result.push(x[i]);\n      i++;\n    }\n  }\n  return result;\n};\n\nmodule.exports = { splitEscaped };<|im_end|>",
