    "raw_output": "```typescript\nexport function collapseRuns(values: readonly number[]): number[] {\n  if (values.length === 0) {\n    return [];\n  }\n\n  const result: number[] = [];\n  let i = 0;\n\n  while (i < values.length) {\n    const current = values[i];\n    let count = 1;\n\n    while (i + 1 < values.length && values[i + 1] === current) {\n      i++;\n      count++;\n    }\n\n    result.push(current);\n    i++;\n  }\n\n  return result;\n}\n```<|im_end|>",
