    "raw_output": "export function resolvePermissions(role: string, parents: Record<string,string>, grants: Record<string,string[]>): string[] | null {\n  const g = grants;\n  const p = parents;\n  if (!g[role]) return null;\n  const res = g[role].slice();\n  for (const parent of g[role]) {\n    if (!p[parent]) return null;\n    const sub = resolvePermissions(parent, p, g);\n    if (sub) {\n      res = res.concat(sub);\n    }\n  }\n  res.sort();\n  return res;\n}<|im_end|>",
