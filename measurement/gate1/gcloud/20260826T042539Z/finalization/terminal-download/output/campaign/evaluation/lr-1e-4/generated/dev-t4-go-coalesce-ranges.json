    "raw_output": "package solution\n\nfunc CoalesceRanges(values [][2]int) ([][2]int, bool) {\n\tn := len(values)\n\tif n == 0 {\n\t\treturn [][2]int{}, true\n\t}\n\tsort.SliceStable(values, func(i, j int) bool {\n\t\tif values[i][0] != values[j][0] {\n\t\t\treturn values[i][0] < values[j][0]\n\t\t}\n\t\treturn values[i][1] <= values[j][1]\n\t})\n\tres := make([][2]int, 0, n)\n\tfor _, v := range values {\n\t\tif v[0] < v[1] {\n\t\t\tres = append(res, v)\n\t\t}\n\t}\n\tfor i := 0; i+1 < len(res); i++ {\n\t\tif res[i][1] <= res[i+1][0] {\n\t\t\tres[i] = append(res[i], res[i+1]...)\n\t\t\tres = append(res[:i], res[i+1:]...)\n\t\t\ti--\n\t\t}\n\t}\n\treturn res, true\n}<|im_end|>",
