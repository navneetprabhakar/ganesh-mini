    "raw_output": "pub fn rolling_checksums(values: &[i32], window: usize) -> Option<Vec<i32>> {\n    if window == 0 {\n        return None;\n    }\n    if window > values.len() {\n        return Some(vec![]);\n    }\n\n    let mut result = Vec::with_capacity(values.len() - window + 1);\n\n    for i in 0..values.len() {\n        let mut current_sum = 0;\n        for j in 0..window {\n            let offset = j + 1;\n            current_sum += (values[i + offset] as i64) * offset;\n        }\n        result.push(current_sum);\n    }\n\n    Some(result)\n}<|im_end|>",
