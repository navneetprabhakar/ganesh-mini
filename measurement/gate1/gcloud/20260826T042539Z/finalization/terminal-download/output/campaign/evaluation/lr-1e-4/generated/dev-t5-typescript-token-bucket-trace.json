    "raw_output": "export function tokenBucketTrace(capacity: number, initial: number, refill: number, costs: readonly number[]): number[] | null {\n  let tokens = initial;\n  if (capacity <= 0 || initial <= 0 || refill <= 0) {\n    return null;\n  }\n  if (initial > capacity) {\n    tokens = capacity;\n  }\n  const result: number[] = [];\n  for (const cost of costs) {\n    if (cost < 0) {\n      return null;\n    }\n    if (tokens < 0) {\n      tokens = 0;\n    }\n    result.push(Math.min(capacity, tokens + refill) - cost);\n    if (result[result.length - 1] < 0) {\n      tokens = result[result.length - 1] + cost;\n    }\n  }\n  return result;\n}<|im_end|>",
