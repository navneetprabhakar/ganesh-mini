{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "purpose", "promotion_authority", "training_allowed", "bindings_sha256", "resource", "cost", "runtime", "inputs", "hard_stops", "proposal_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-checkpoint-sweep-gcloud-proposal/v1"},
    "status": {"const": "pending-explicit-execution-approval"},
    "promotion_authority": {"const": "none"},
    "training_allowed": {"const": false},
    "resource": {
      "type": "object",
      "properties": {
        "machine_type": {"const": "g2-standard-8"}, "accelerator": {"const": "1x NVIDIA L4"},
        "external_ip": {"const": false}, "automatic_restart": {"const": false},
        "boot_disk_auto_delete": {"const": true}, "maximum_vm_lifetime_seconds": {"const": 7200}
      },
      "required": ["machine_type", "accelerator", "external_ip", "automatic_restart", "boot_disk_auto_delete", "maximum_vm_lifetime_seconds"]
    },
    "cost": {"type": "object", "properties": {"absolute_cost_ceiling_usd": {"const": "2.25"}}, "required": ["absolute_cost_ceiling_usd"]}
  }
}
