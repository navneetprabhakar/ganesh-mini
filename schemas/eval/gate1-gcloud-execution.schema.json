{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-staged-gcloud-execution/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "gate",
    "gate_range",
    "source_commit",
    "preparation_sha256",
    "bindings_sha256",
    "approval",
    "model",
    "evaluation",
    "training",
    "execution",
    "cost",
    "inputs",
    "launch",
    "cuda_image",
    "boot_image",
    "required_terminal_state",
    "execution_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ganesh-mini-staged-gcloud-execution/v1"},
    "status": {"const": "authorized-executable"},
    "gate": {"const": 1},
    "gate_range": {"const": [1, 3]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "preparation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval": {"type": "object"},
    "model": {"type": "object"},
    "evaluation": {"type": "object"},
    "training": {"type": "object"},
    "execution": {"type": "object"},
    "cost": {"type": "object"},
    "inputs": {"type": "object"},
    "launch": {"type": "object"},
    "cuda_image": {"type": "object"},
    "boot_image": {"type": "string"},
    "required_terminal_state": {"type": "array", "items": {"type": "string"}},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
