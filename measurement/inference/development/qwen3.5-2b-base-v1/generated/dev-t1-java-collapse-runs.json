    "raw_output": "public final class Solution {\n    public static List<Integer> collapseRuns(List<Integer> values) {\n        if (values == null || values.isEmpty()) {\n            return new ArrayList<>();\n        }\n\n        List<Integer> result = new ArrayList<>();\n        int i = 0;\n        int n = values.size();\n\n        while (i < n) {\n            int current = values.get(i);\n            int j = i + 1;\n            int count = 1;\n\n            while (j < n && values.get(j) == current) {\n                j++;\n                count++;\n            }\n\n            result.add(current);\n            i = j;\n        }\n\n        return result;\n    }\n}<|im_end|>",
