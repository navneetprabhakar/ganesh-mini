{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-gate3-price-evidence/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checked_at", "region", "machine_type", "source", "conservative_hourly_usd", "support_reserve_usd", "absolute_cost_ceiling_usd", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-gate3-price-evidence/v3"},
    "status": {"const": "verified"},
    "checked_at": {"type": "string"},
    "region": {"const": "us-east1"},
    "machine_type": {"const": "g2-standard-12"},
    "source": {"type": "string"},
    "conservative_hourly_usd": {"type": "string"},
    "support_reserve_usd": {"type": "string"},
    "absolute_cost_ceiling_usd": {"type": "string"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
