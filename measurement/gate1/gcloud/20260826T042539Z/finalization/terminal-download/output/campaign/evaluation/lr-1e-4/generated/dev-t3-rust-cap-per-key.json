    "raw_output": "fn cap_per_key(keys: &[String], limit: isize) -> Option<Vec<usize>> {\n    if limit < 0 {\n        return None;\n    }\n    let n = keys.len() as isize;\n    if n == 0 {\n        return Some(vec![]);\n    }\n    let mut result: Vec<usize> = Vec::new();\n    let mut i: usize = 0;\n    while i < n {\n        if result.len() as isize >= limit {\n            break;\n        }\n        if keys[i] == keys[0] {\n            result.push(i);\n            i += 1;\n        } else {\n            i += 1;\n        }\n    }\n    Some(result)\n}<|im_end|>",
