    "extracted_code": "import java.util.*;\nimport java.util.stream.*;\n\npublic final class Solution {\n    public static Long reconcileLedger(long opening, List<long[]> entries) {\n        Map<Long, Long> balance = new HashMap<>();\n        balance.put(opening, opening);\n        for (long[] e : entries) {\n            long id = e[0];\n            long kind = e[1];\n            long amount = e[2];\n            if (balance.containsKey(id)) {\n                return null;\n            }\n            if (kind != 1 && kind != -1) {\n                return null;\n            }\n            if (amount <= 0) {\n                return null;\n            }\n            balance.put(id, balance.get(id) + (kind == 1 ? amount : -amount));\n        }\n        return balance.get(opening);\n    }\n}\n",
