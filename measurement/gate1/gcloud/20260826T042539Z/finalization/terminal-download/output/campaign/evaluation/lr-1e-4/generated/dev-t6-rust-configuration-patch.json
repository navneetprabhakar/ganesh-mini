    "raw_output": "fn patch_config(base: &[(&str, &str)], patches: &[(&str, &str, &str)]) -> Option<Vec<String>> {\n    let mut res: Vec<String> = Vec::new();\n    for (k, v) in base.iter() {\n        res.push(format!(\"{}={}\", k, v));\n    }\n    for (op, k, v) in patches {\n        if *k == \"unset\" || *k == \"set\" {\n            if *k == \"unset\" && !res.iter().any(|r| r.contains(*k)) {\n                res.retain(|r| !r.contains(*k));\n            }\n            if *k == \"set\" && !res.iter().any(|r| r.contains(*k)) {\n                res.push(format!(\"{}={}\", *k, *v));\n            }\n        } else {\n            return None;\n        }\n    }\n    Some(res)\n}<|im_end|>",
