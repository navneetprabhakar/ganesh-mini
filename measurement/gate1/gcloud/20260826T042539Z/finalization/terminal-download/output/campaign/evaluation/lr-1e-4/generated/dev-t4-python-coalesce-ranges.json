    "raw_output": "def coalesce_ranges(values: list[tuple[int,int]]) -> list[tuple[int,int]] | None:\n    if not values:\n        return None\n    ranges = sorted(values, key=lambda x: (x[0], x[1]))\n    merged = []\n    for start, end in ranges:\n        if not merged or merged[-1][1] < start:\n            merged.append((start, end))\n        elif merged[-1][0] == start and merged[-1][1] >= end:\n            merged[-1] = (start, end)\n        else:\n            merged.append((start, end))\n    return merged<|im_end|>",
