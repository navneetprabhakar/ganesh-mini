    "raw_output": "package solution\n\nimport \"fmt\"\n\n// State represents the current state of the session.\ntype State int\n\nconst (\n\tStateClosed State = iota\n\tStateOpen\n\tStateAuthenticated\n\tStateReady\n)\n\n// RunSession implements the required API.\n// It tracks the state transitions based on the provided event list.\n// Transitions are defined as:\n// - Closed -> Open\n// - Open -> Authenticated\n// - Authenticated -> Ready\n// - Ready -> Ready\n// - Open/Ready -> Closed\n// Any other transition results in rejection.\nfunc RunSession(events []string) (string, bool) {\n\tstate := StateClosed\n\trejected := false\n\n\tfor _, event := range events {\n\t\tswitch state {\n\t\tcase StateClosed:\n\t\t\tif event == \"open\" {\n\t\t\t\tstate = StateOpen\n\t\t\t} else {\n\t\t\t\trejected = true\n\t\t\t\tbreak\n\t\t\t}\n\t\tcase StateOpen:\n\t\t\tif event == \"authenticate\" {\n\t\t\t\tstate = StateAuthenticated\n\t\t\t} else if event == \"close\" {\n\t\t\t\tstate = StateClosed\n\t\t\t} else {\n\t\t\t\trejected = true\n\t\t\t\tbreak\n\t\t\t}\n\t\tcase StateAuthenticated:\n\t\t\tif event == \"ping\" {\n\t\t\t\tstate = StateReady\n\t\t\t} else {\n\t\t\t\trejected = true\n\t\t\t\tbreak\n\t\t\t}\n\t\tcase StateReady:\n\t\t\tif event == \"close\" {\n\t\t\t\tstate = StateClosed\n\t\t\t} else {\n\t\t\t\t// Any other event on Ready is rejected\n\t\t\t\trejected = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\n\tif rejected {\n\t\treturn \"\", false\n\t}\n\n\treturn fmt.Sprintf(\"%d\", state), true\n}<|im_end|>",
