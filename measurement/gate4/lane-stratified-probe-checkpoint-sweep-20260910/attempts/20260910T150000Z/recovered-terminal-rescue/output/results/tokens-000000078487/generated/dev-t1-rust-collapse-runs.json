    "raw_output": "pub fn collapse_runs(values: &[i32]) -> Vec<i32> {\n    if values.is_empty() {\n        return Vec::new();\n    }\n\n    let mut result: Vec<i32> = Vec::new();\n    let mut i = 0;\n\n    while i < values.len() {\n        let mut current_run: Vec<i32> = Vec::new();\n        let mut j = i;\n\n        while j < values.len() && values[j] == values[j - 1] {\n            current_run.push(values[j]);\n            j += 1;\n        }\n\n        if !current_run.is_empty() {\n            result.push(current_run[0]);\n        }\n\n        i = j;\n    }\n\n    result\n}<|im_end|>",
