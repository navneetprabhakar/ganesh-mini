    "output_token_ids_sha256": "55fd1138d5771d828ec91ef9fe9fb093ad1931dda4ee39ef543f6f9a7d161398",
    "raw_output": "function tokenBucketTrace(capacity, initial, refill, costs) {\n  if (capacity <= 0 || initial <= 0 || refill <= 0 || costs.length === 0) {\n    return null;\n  }\n  const tokens = initial;\n  const result = [];\n  for (let i = 0; i < costs.length; i++) {\n    if (tokens < 0) {\n      result.push(-1);\n      tokens = 0;\n      continue;\n    }\n    if (tokens > capacity) {\n      tokens = capacity;\n    }\n    if (costs[i] <= tokens) {\n      tokens -= costs[i];\n    } else {\n      result.push(-1);\n    }\n  }\n  return result;\n}\n\nmodule.exports.tokenBucketTrace = tokenBucketTrace;<|im_end|>",
