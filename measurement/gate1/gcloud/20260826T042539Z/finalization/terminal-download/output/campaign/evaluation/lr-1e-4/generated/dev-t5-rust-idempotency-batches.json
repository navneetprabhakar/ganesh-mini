    "raw_output": "fn idempotency_batch_trace(keys: &[String], amounts: &[i32]) -> Option<Vec<i32>> {\n    if keys.is_empty() {\n        return Some(vec![]);\n    }\n    let n = keys.len();\n    if amounts.len() != n {\n        return None;\n    }\n    let mut res: Vec<i32> = Vec::new();\n    let mut i: usize = 0;\n    while i < n {\n        let key = keys[i];\n        let mut j: usize = 0;\n        while j < n && keys[j] == key {\n            res.push(amounts[i] + amounts[j]);\n            j += 1;\n        }\n        i = j;\n    }\n    Some(res)\n}<|im_end|>",
