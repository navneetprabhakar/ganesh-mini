    "raw_output": "```javascript\n/**\n * Finds the minimum score for each unique key in the input arrays.\n * Ties are broken by the earliest index.\n * Returns the indices in the order of the first appearance of each key.\n *\n * @param {number[]} keys - Array of keys.\n * @param {number[]} scores - Array of scores corresponding to keys.\n * @returns {number[]} - Array of indices for the minimum score of each key, or null if input is invalid.\n */\nfunction firstMinPerKey(keys, scores) {\n  // Validate input lengths\n  if (keys.length !== scores.length) {\n    return null;\n  }\n\n  // Create a map to store the minimum score and its index for each key\n  // We use a Map to preserve insertion order of keys as they first appear\n  const minMap = new Map();\n\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    const score = scores[i];\n\n    if (!minMap.has(key)) {\n      // First time seeing this key, initialize with current score and index\n      minMap.set(key, { minScore: score, minIndex: i });\n    } else {\n      // Compare with existing minimum\n      const existing = minMap.get(key);\n      if (score < existing.minScore) {\n        minMap.set(key, { minScore: score, minIndex: i });\n      } else if (score === existing.minScore) {\n        // Tie-breaker: earliest index wins\n        if (i < existing.minIndex) {\n          minMap.set(key, { minScore: score, minIndex: i });\n        }\n      }\n    }\n  }\n\n  // Extract the indices in the order of first appearance\n  const result = [];\n  for (const key of minMap.keys()) {\n    result.push(minMap.get(key).minIndex);\n  }\n\n  return result;\n}\n\nmodule.exports.firstMinPerKey = firstMinPerKey;\n```<|im_end|>",
