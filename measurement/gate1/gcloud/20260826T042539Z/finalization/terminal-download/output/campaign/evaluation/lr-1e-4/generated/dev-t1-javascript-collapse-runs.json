    "raw_output": "function collapseRuns(values) {\n  if (values.length === 0) {\n    return [];\n  }\n  const result = [];\n  let i = 0;\n  while (i < values.length) {\n    const j = i;\n    while (j + 1 < values.length && values[j] === values[j + 1]) {\n      j += 1;\n    }\n    result.push(values[i] === values[j] ? values[i] : null);\n    i = j + 1;\n  }\n  return result;\n}\n\nmodule.exports.collapseRuns = collapseRuns;<|im_end|>",
