    "raw_output": "def first_min_per_key(keys: list[str], scores: list[int]) -> list[int] | None:\n    if len(keys) != len(scores):\n        return None\n    \n    result = []\n    key_to_idx = {}\n    key_order = []\n    \n    for i, key in enumerate(keys):\n        if key not in key_to_idx:\n            key_to_idx[key] = i\n            key_order.append(key)\n        else:\n            return None\n    \n    for key in key_order:\n        idx = key_to_idx[key]\n        if idx < len(scores):\n            min_score = scores[idx]\n            min_indices = [idx]\n            for j in range(idx + 1, len(scores)):\n                if scores[j] < min_score:\n                    min_score = scores[j]\n                    min_indices = [j]\n                elif scores[j] == min_score:\n                    min_indices.append(j)\n            result.extend(min_indices)\n    \n    return result<|im_end|>",
