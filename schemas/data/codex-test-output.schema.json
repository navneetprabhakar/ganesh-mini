{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "test_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "test_code": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
