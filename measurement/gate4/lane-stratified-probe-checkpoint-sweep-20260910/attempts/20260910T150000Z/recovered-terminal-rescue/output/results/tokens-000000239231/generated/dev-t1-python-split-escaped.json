    "raw_output": "from typing import Optional\n\ndef split_escaped(x: str) -> Optional[list[str]]:\n    \"\"\"\n    Split on unescaped commas. Backslash may escape only comma or backslash.\n    Preserve empty fields. Return failure value for another escape or trailing backslash.\n    \"\"\"\n    if not x:\n        return None\n\n    result = []\n    i = 0\n    n = len(x)\n    while i < n:\n        if x[i] == '\\\\' and i + 1 < n:\n            # Check if next char is backslash (escape) or comma (unescaped)\n            if x[i + 1] == '\\\\':\n                i += 2\n            else:\n                # Unescaped comma\n                result.append(x[i:i+1])\n                i += 1\n        else:\n            result.append(x[i])\n            i += 1\n\n    if i == n:\n        return None\n\n    return result<|im_end|>",
