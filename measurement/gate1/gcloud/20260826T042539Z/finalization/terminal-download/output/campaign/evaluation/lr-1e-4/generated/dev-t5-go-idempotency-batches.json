    "raw_output": "package solution\n\nfunc IdempotencyBatchTrace(keys []string, amounts []int) ([]int, bool) {\n\tif len(keys) == 0 {\n\t\treturn []int{}, true\n\t}\n\tif len(keys) != len(amounts) {\n\t\treturn nil, false\n\t}\n\tres := make([]int, 0, len(keys))\n\tfor i := 0; i < len(keys); i++ {\n\t\tres = append(res, amounts[i])\n\t}\n\tsum := 0\n\tfor _, v := range res {\n\t\tsum += v\n\t}\n\treturn res, sum == 0\n}<|im_end|>",
