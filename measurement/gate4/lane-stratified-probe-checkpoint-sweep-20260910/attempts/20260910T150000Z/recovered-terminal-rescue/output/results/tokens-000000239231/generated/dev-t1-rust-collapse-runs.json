    "raw_output": "pub fn collapse_runs(values: &[i32]) -> Vec<i32> {\n    if values.is_empty() {\n        return Vec::new();\n    }\n\n    let mut result: Vec<i32> = Vec::with_capacity(values.len());\n    let mut current: i32 = values[0];\n    let mut count: usize = 1;\n\n    for i in 1..values.len() {\n        if values[i] == current {\n            count += 1;\n        } else {\n            result.push(current);\n            current = values[i];\n            count = 1;\n        }\n    }\n    result.push(current);\n\n    result\n}<|im_end|>",
