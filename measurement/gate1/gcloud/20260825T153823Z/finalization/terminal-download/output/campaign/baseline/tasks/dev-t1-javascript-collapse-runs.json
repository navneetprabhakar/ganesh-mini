  "extraction": {
    "extracted_code": "/**\n * Collapse adjacent runs of identical numbers.\n * \n * @param {number[]} values - Input array of numbers.\n * @returns {number[]} - Array containing one value for each maximal adjacent run.\n * \n * @example\n * collapseRuns([2,2,1,1,2]) => [2,1,2]\n * collapseRuns([1,2,3,4]) => [1,2,3,4]\n * collapseRuns([]) => []\n */\nfunction collapseRuns(values) {\n  if (values.length === 0) {\n    return [];\n  }\n\n  const result = [];\n  let currentRun = values[0];\n\n  for (let i = 1; i < values.length; i++) {\n    if (values[i] === currentRun) {\n      // Continue the current run\n      currentRun = values[i];\n    } else {\n      // End of current run, add to result and start new\n      result.push(currentRun);\n      currentRun = values[i];\n    }\n  }\n\n  // Add the last run\n  result.push(currentRun);\n\n  return result;\n}\n\n// CommonJS export\nmodule.exports.collapseRuns = collapseRuns;\n",
