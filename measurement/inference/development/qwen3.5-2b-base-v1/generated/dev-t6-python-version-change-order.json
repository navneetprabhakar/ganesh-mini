    "raw_output": "def order_changes(changes: list[tuple[int,int,int,int,int]]) -> list[int] | None:\n    if not changes:\n        return None\n    seen_ids = set()\n    valid_changes = []\n    for change in changes:\n        id_, major, minor, patch, sequence = change\n        if id_ in seen_ids:\n            continue\n        if id_ < 0 or major < 0 or minor < 0 or patch < 0 or sequence < 0:\n            continue\n        seen_ids.add(id_)\n        valid_changes.append(change)\n    valid_changes.sort(key=lambda c: (c[1], c[2], c[3], c[4], c[0]))\n    return [c[0] for c in valid_changes]<|im_end|>",
