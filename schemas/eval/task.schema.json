{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganesh-mini.local/schemas/eval/task.schema.json",
  "title": "Ganesh Mini evaluation task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "surface", "language", "family",
    "task_type", "prompt", "rendered_prompt", "candidate_path", "files",
    "runtime_id", "limits", "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "surface": {
      "enum": ["synthetic_harness", "diagnostic", "development", "decision"]
    },
    "language": {
      "enum": ["go", "java", "javascript", "typescript", "python", "rust"]
    },
    "family": {"enum": ["go", "java", "javascript_typescript", "python", "rust"]},
    "task_type": {"enum": ["generation", "repair"]},
    "prompt": {"$ref": "#/$defs/hashedText"},
    "rendered_prompt": {"$ref": "#/$defs/hashedText"},
    "candidate_path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "runtime_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "memory_mb", "cpus", "pids", "output_bytes"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 2048},
        "cpus": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "pids": {"type": "integer", "minimum": 8, "maximum": 256},
        "output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "known_bad"],
      "properties": {
        "reference": {"$ref": "#/$defs/artifact"},
        "known_bad": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashedText": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {"text": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "content", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
        "role": {"enum": ["test", "support"]},
        "content": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "code", "sha256"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "code": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
