    "raw_output": "import java.util.ArrayList;\nimport java.util.List;\n\npublic class Solution {\n    public static List<Integer> capPerKey(List<String> keys, int limit) {\n        if (limit < 0) {\n            throw new IllegalArgumentException(\"limit must be non-negative\");\n        }\n        if (keys == null || keys.isEmpty()) {\n            return new ArrayList<>();\n        }\n        int n = keys.size();\n        int[] idx = new int[n];\n        for (int i = 0; i < n; i++) {\n            idx[i] = i;\n        }\n        int limitCount = 0;\n        for (int i = 0; i < n; i++) {\n            int j = i;\n            while (j < n && limitCount < limit) {\n                if (keys.get(j).equals(keys.get(i))) {\n                    idx[j] = i;\n                    limitCount++;\n                    j++;\n                } else {\n                    break;\n                }\n            }\n        }\n        return new ArrayList<>(idx);\n    }\n}<|im_end|>",
