    "raw_output": "export function parseQuotedList(text: string): string[] | null {\n  if (text === '') {\n    return [];\n  }\n\n  const parts = text.split(',');\n  const result: string[] = [];\n\n  for (const part of parts) {\n    const trimmed = part.trim();\n    if (trimmed === '') {\n      result.push('');\n      continue;\n    }\n\n    if (trimmed.startsWith('\"') && trimmed.endsWith('\"')) {\n      const inner = trimmed.slice(1, -1);\n      if (inner.length === 0) {\n        result.push('');\n      } else {\n        result.push(inner);\n      }\n    } else {\n      return null;\n    }\n  }\n\n  return result;\n}<|im_end|>",
