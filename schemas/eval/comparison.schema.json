{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganesh-mini.local/schemas/eval/comparison.schema.json",
  "title": "Ganesh Mini paired comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_model", "candidate_model", "base", "candidate", "paired", "five_family_macro_delta"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "base_model": {"type": "object"},
    "candidate_model": {"type": "object"},
    "base": {"$ref": "#/$defs/cohort"},
    "candidate": {"$ref": "#/$defs/cohort"},
    "paired": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregate", "lanes"],
      "properties": {
        "aggregate": {"$ref": "#/$defs/transitions"},
        "lanes": {
          "type": "object",
          "required": ["go", "java", "javascript", "typescript", "python", "rust"],
          "additionalProperties": {"$ref": "#/$defs/transitions"}
        }
      }
    },
    "five_family_macro_delta": {"$ref": "#/$defs/fraction"}
  },
  "$defs": {
    "fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "fraction", "decimal"],
      "properties": {
        "numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1},
        "fraction": {"type": "string"}, "decimal": {"type": "number"}
      }
    },
    "transitions": {
      "type": "object", "additionalProperties": false,
      "required": ["wins", "losses", "ties", "denominator"],
      "properties": {
        "wins": {"type": "integer", "minimum": 0}, "losses": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}
      }
    },
    "cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["task_count", "lanes", "families", "five_family_macro"],
      "properties": {
        "task_count": {"type": "integer", "minimum": 1},
        "lanes": {"type": "object"}, "families": {"type": "object"},
        "five_family_macro": {"$ref": "#/$defs/fraction"}
      }
    }
  }
}
