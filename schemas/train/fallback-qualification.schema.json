{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-fallback-qualification/v1",
  "type": "object",
  "required": ["schema_version", "passed", "model_id", "revision", "primary_recipe_id", "primary_recipe_sha256", "fallback_recipe_id", "fallback_recipe_sha256", "reason", "primary_attempt", "measurements", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-fallback-qualification/v1"},
    "passed": {"const": true},
    "reason": {"enum": ["primary_cuda_oom", "primary_peak_vram_exceeded", "primary_cost_threshold_exceeded"]},
    "primary_attempt": {
      "type": "object",
      "required": ["attempt_id", "observed_at", "measurement_source", "measurement_sha256"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "measurement_source": {"enum": ["cuda_runtime", "gpu_telemetry", "cost_projection"]},
        "measurement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "measurements": {
      "type": "object",
      "properties": {
        "cuda_oom_observed": {"type": "boolean"},
        "peak_vram_gb": {"type": ["number", "null"]},
        "primary_projected_cost_usd": {"type": ["number", "null"]},
        "fallback_projected_cost_usd": {"type": ["number", "null"]}
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
