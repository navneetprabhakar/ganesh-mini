    "output_token_ids_sha256": "617bfe96c06f95bcf7fb3189652267b7a14087099ec3601c92e3f00cad84ce27",
    "raw_output": "def resolve_permissions(role: str, parents: dict[str,str], grants: dict[str,list[str]]) -> list[str] | None:\n    \"\"\"Resolve a role's permissions by collecting grants from the role and all its parents,\n    deduplicating, and sorting. Rejects unknown roles, unknown parents, or inheritance cycles.\"\"\"\n    if role not in grants:\n        return None\n    role_grants = set(grants[role])\n    visited = set()\n    queue = [parents[role]]\n    while queue:\n        parent = queue.pop(0)\n        if parent in visited:\n            return None\n        visited.add(parent)\n        if parent in grants:\n            for g in grants[parent]:\n                if g not in role_grants:\n                    role_grants.add(g)\n        queue.append(parents[parent])\n    return sorted(role_grants)<|im_end|>",
