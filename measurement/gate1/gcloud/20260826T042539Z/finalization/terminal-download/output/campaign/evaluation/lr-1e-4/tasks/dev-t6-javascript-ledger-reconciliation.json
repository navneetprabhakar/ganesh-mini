    "extracted_code": "function reconcileLedger(opening, entries) {\n  const seen = new Set();\n  let total = opening;\n  for (const entry of entries) {\n    if (seen.has(entry.id)) {\n      throw new Error(\"duplicate id\");\n    }\n    if (entry.kind !== 1 && entry.kind !== -1) {\n      throw new Error(\"invalid kind\");\n    }\n    if (entry.amount <= 0) {\n      throw new Error(\"non-positive amount\");\n    }\n    if (entry.kind === 1) {\n      total += entry.amount;\n    } else {\n      total -= entry.amount;\n    }\n    seen.add(entry.id);\n  }\n  return total;\n}\n\nmodule.exports = { reconcileLedger };\n",
