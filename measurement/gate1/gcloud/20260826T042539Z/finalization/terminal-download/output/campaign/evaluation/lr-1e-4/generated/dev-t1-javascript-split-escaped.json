    "raw_output": "function splitEscaped(x) {\n  if (typeof x !== 'string') {\n    return null;\n  }\n  const result = [];\n  let i = 0;\n  while (i < x.length) {\n    if (x[i] === '\\\\' && (i + 1 < x.length && (x[i + 1] === ',' || x[i + 1] === '\\\\'))) {\n      result.push('');\n      i += 2;\n    } else {\n      const j = i;\n      while (j < x.length && x[j] !== ',') {\n        j += 1;\n      }\n      if (j === x.length) {\n        result.push('');\n      } else {\n        result.push(x.slice(i, j));\n      }\n      i = j;\n    }\n  }\n  return result;\n}\n\nmodule.exports.splitEscaped = splitEscaped;<|im_end|>",
