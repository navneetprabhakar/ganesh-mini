    "raw_output": "fn collapse_runs(values: &[i32]) -> Vec<i32> {\n    if values.is_empty() {\n        return Vec::new();\n    }\n    let mut result: Vec<i32> = Vec::new();\n    let mut i = 0;\n    while i < values.len() {\n        let mut j = i;\n        while j < values.len() && values[j] == values[j - 1] {\n            j += 1;\n        }\n        result.push(values[i]);\n        i = j;\n    }\n    result\n}<|im_end|>",
