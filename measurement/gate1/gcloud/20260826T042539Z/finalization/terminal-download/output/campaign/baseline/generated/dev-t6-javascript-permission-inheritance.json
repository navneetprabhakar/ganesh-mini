    "output_token_ids_sha256": "7e6b9de9d198480f4d5ca66b339e098c62af1ef00e388f55371773ca83798842",
    "raw_output": "```javascript\nconst { resolvePermissions } = require('./utils');\n\nmodule.exports.resolvePermissions = function(role, parents, grants) {\n  // Validate input types\n  if (typeof role !== 'string' || typeof parents !== 'object' || typeof grants !== 'object') {\n    throw new Error('Invalid input types');\n  }\n\n  // Validate parents object\n  if (!parents || Object.keys(parents).length === 0) {\n    return [];\n  }\n\n  // Validate grants object\n  if (!grants || Object.keys(grants).length === 0) {\n    return [];\n  }\n\n  // Normalize grants to an array of strings\n  const grantSet = new Set(grants);\n\n  // Check for unknown role\n  if (!grants[role]) {\n    throw new Error(`Unknown role: ${role}`);\n  }\n\n  // Check for unknown parent\n  if (!parents[role]) {\n    throw new Error(`Unknown parent: ${role}`);\n  }\n\n  // Build the permission set\n  const result = new Set();\n\n  // Add the role's own grants\n  for (const grant of grants[role]) {\n    result.add(grant);\n  }\n\n  // Recursively add grants from parents\n  const visited = new Set();\n  const queue = [parents[role]];\n\n  while (queue.length > 0) {\n    const currentRole = queue.shift();\n\n    // Skip if we've already visited this role (cycle detection)\n    if (visited.has(currentRole)) {\n      continue;\n    }\n    visited.add(currentRole);\n\n    // If the parent is an empty object, it's a root role\n    if (Object.keys(parents[currentRole]).length === 0) {\n      continue;\n    }\n\n    // Add parent's grants\n    for (const grant of grants[currentRole]) {\n      result.add(grant);\n    }\n\n    // Add children to the queue\n    for (const child of parents[currentRole]) {\n      if (!visited.has(child)) {\n        queue.push(child);\n      }\n    }\n  }\n\n  // Sort the result alphabetically\n  return Array.from(result).sort();\n};\n```<|im_end|>",
