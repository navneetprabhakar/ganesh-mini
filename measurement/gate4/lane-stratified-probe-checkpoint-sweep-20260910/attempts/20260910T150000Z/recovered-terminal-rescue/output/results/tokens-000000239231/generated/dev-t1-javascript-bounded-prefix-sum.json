    "raw_output": "import { BigInt } from \"bigint\";\n\nexport function boundedPrefixSum(values, bound) {\n  if (typeof bound !== \"number\" || !Number.isFinite(bound)) {\n    return null;\n  }\n  if (bound < 0) {\n    return null;\n  }\n  let currentSum = BigInt(0);\n  for (const value of values) {\n    currentSum = currentSum + BigInt(value);\n    if (currentSum < BigInt(bound) || currentSum > BigInt(-bound)) {\n      return null;\n    }\n  }\n  return currentSum;\n}<|im_end|>",
