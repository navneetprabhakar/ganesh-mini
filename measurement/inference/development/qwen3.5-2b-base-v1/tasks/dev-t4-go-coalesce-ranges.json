    "extracted_code": "package solution\n\nfunc CoalesceRanges(values [][2]int) ([][2]int, bool) {\n\tif len(values) == 0 {\n\t\treturn [][2]int{}, true\n\t}\n\n\t// Sort ranges by start time\n\tsort.Slice(values, func(i, j int) bool {\n\t\tif values[i][0] == values[j][0] {\n\t\t\treturn values[i][1] < values[j][1]\n\t\t}\n\t\treturn values[i][0] < values[j][0]\n\t})\n\n\t// Merge overlapping or touching ranges\n\tresult := make([][2]int, 0, len(values))\n\tfor _, v := range values {\n\t\tif len(result) == 0 {\n\t\t\tresult = append(result, v)\n\t\t} else {\n\t\t\tlast := result[len(result)-1]\n\t\t\t// Check if current range overlaps or touches the last merged range\n\t\t\tif v[0] <= last[1] {\n\t\t\t\t// Merge: extend the end if current range goes further\n\t\t\t\tif v[1] > last[1] {\n\t\t\t\t\tlast[1] = v[1]\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\t// No overlap, add current range\n\t\t\t\tresult = append(result, v)\n\t\t\t}\n\t\t}\n\t}\n\n\treturn result, true\n}\n",
