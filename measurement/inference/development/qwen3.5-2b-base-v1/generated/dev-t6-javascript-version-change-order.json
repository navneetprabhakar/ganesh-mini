    "output_token_ids_sha256": "367ce20c40e03501c3880ac9c7e825b455b27f60cc708073b5eb537c6e0576fe",
    "raw_output": "exports.orderChanges = function(changes) {\n  const seen = new Set();\n  const result = [];\n\n  for (const change of changes) {\n    const id = change[0];\n    const major = change[1];\n    const minor = change[2];\n    const patch = change[3];\n    const sequence = change[4];\n\n    if (seen.has(id)) {\n      throw new Error(`Duplicate ID: ${id}`);\n    }\n\n    if (major < 0 || minor < 0 || patch < 0 || sequence < 0) {\n      throw new Error(`Invalid version or sequence: ${change}`);\n    }\n\n    seen.add(id);\n    result.push({\n      id,\n      major,\n      minor,\n      patch,\n      sequence,\n    });\n  }\n\n  return result.sort((a, b) => {\n    if (a.major !== b.major) return a.major - b.major;\n    if (a.minor !== b.minor) return a.minor - b.minor;\n    if (a.patch !== b.patch) return a.patch - b.patch;\n    if (a.sequence !== b.sequence) return a.sequence - b.sequence;\n    return a.id - b.id;\n  });\n};<|im_end|>",
