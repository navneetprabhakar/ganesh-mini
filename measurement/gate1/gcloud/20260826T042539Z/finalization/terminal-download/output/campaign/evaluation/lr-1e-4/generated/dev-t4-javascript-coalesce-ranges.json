    "raw_output": "function coalesceRanges(values) {\n  if (!Array.isArray(values)) {\n    throw new TypeError(\"coalesceRanges expects an array\");\n  }\n  const sorted = [...values].sort((a, b) => a[0] - b[0]);\n  const merged = [];\n  for (const [start, end] of sorted) {\n    if (merged.length === 0 || merged[merged.length - 1][1] < start) {\n      merged.push([start, end]);\n    } else if (merged[merged.length - 1][0] === start && merged[merged.length - 1][1] === end) {\n      merged[merged.length - 1][1] = end;\n    }\n  }\n  return merged;\n}\n\nmodule.exports = { coalesceRanges };<|im_end|>",
