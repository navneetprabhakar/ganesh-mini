    "extracted_code": "function reconcileLedger(opening: number, entries: Array<[number,number,number]>): number | null {\n  const seen: Set<number> = new Set();\n  let total = opening;\n  for (const [id, kind, amount] of entries) {\n    if (seen.has(id)) {\n      return null;\n    }\n    if (kind !== 1 && kind !== -1) {\n      return null;\n    }\n    if (amount <= 0) {\n      return null;\n    }\n    if (total + amount < 0) {\n      return null;\n    }\n    total += amount;\n    seen.add(id);\n  }\n  return total;\n}\n",
