    "raw_output": "export function clampWindow(start: number, size: number, length: number): readonly [number, number] | null {\n  if (size < 0 || length < 0) return null;\n  const clampedStart = Math.max(0, Math.min(start, length));\n  const end = Math.min(start + size, length);\n  return [clampedStart, end];\n}<|im_end|>",
