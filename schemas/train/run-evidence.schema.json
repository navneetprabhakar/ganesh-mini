{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-training-run-evidence/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "model_id", "revision", "selected_recipe_id", "selected_recipe_sha256", "config_sha256", "dataset_manifest_sha256", "started_at", "stop_reason", "seen_tokens", "effective_epochs_by_lane", "checkpoints", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-training-run-evidence/v1"},
    "status": {"enum": ["completed", "stopped", "failed"]},
    "selected_recipe_id": {"enum": ["bf16-lora-primary-v1", "nf4-qlora-fallback-v1"]},
    "selected_recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stop_reason": {"enum": ["token_budget_reached", "wall_time_reached", "cost_ceiling_reached", "non_finite_loss", "three_consecutive_loss_spikes", "checkpoint_write_failure", "evidence_write_failure", "operator_stop", "completed"]},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
