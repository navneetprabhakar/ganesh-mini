{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganesh-mini.local/schemas/eval/result.schema.json",
  "title": "Ganesh Mini evaluation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "surface", "language", "family",
    "task_sha256", "prompt_sha256", "rendered_prompt_sha256", "model",
    "inference", "candidate", "verifier", "passed", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string"},
    "surface": {"enum": ["synthetic_harness", "diagnostic", "development", "decision"]},
    "language": {"enum": ["go", "java", "javascript", "typescript", "python", "rust"]},
    "family": {"enum": ["go", "java", "javascript_typescript", "python", "rust"]},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "rendered_prompt_sha256": {"$ref": "#/$defs/sha256"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision", "artifact_sha256", "serving_contract_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "serving_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["parameters", "parameters_sha256", "started_at", "completed_at"],
      "properties": {
        "parameters": {"type": "object"},
        "parameters_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_output", "raw_output_sha256", "extracted_code", "extracted_code_sha256", "extractor_id"],
      "properties": {
        "raw_output": {"type": "string"},
        "raw_output_sha256": {"$ref": "#/$defs/sha256"},
        "extracted_code": {"type": "string"},
        "extracted_code_sha256": {"$ref": "#/$defs/sha256"},
        "extractor_id": {"type": "string", "minLength": 1}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": [
        "runtime_id", "image", "image_id", "commands", "exit_codes",
        "timed_out", "stdout", "stdout_sha256", "stderr", "stderr_sha256",
        "duration_ms", "sandbox_contract_sha256"
      ],
      "properties": {
        "runtime_id": {"type": "string"},
        "image": {"type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
        "exit_codes": {"type": "array", "items": {"type": "integer"}},
        "timed_out": {"type": "boolean"},
        "stdout": {"type": "string"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr": {"type": "string"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "sandbox_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "passed": {"type": "boolean"},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
