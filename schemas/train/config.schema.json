{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-train-config/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "output_model_name", "model", "data", "prerequisites", "rendering", "strategy", "recipes", "control", "outputs"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-train-config/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "output_model_name": {"const": "ganesh-mini-1.0"},
    "model": {"type": "object"},
    "data": {"type": "object"},
    "prerequisites": {"type": "object"},
    "rendering": {"type": "object"},
    "strategy": {
      "type": "object",
      "required": ["selected_recipe_id", "fallback_reason", "fallback_qualification_path"],
      "properties": {
        "selected_recipe_id": {"enum": ["bf16-lora-primary-v1", "nf4-qlora-fallback-v1"]},
        "fallback_reason": {"type": ["string", "null"], "enum": [null, "primary_cuda_oom", "primary_peak_vram_exceeded"]},
        "fallback_qualification_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "object",
      "required": ["primary", "fallback"],
      "properties": {
        "primary": {"type": "object"},
        "fallback": {"type": "object"}
      },
      "additionalProperties": false
    },
    "control": {"type": "object"},
    "outputs": {"type": "object"}
  },
  "additionalProperties": false
}
