{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-gate3-terminal-validation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "attempt_id",
    "expected_prefix",
    "execution_sha256",
    "backup_manifest_sha256",
    "runtime_inventory_sha256",
    "runtime_inventory_entries",
    "terminal_object_count",
    "startup_exit_code",
    "controller_exit_code",
    "run",
    "deletion_eligible",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ganesh-mini-gate3-terminal-validation/v2"},
    "status": {"enum": ["passed", "sealed-failure"]},
    "attempt_id": {"type": "string"},
    "expected_prefix": {"type": "string"},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backup_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_inventory_entries": {"type": "integer", "minimum": 1},
    "terminal_object_count": {"type": "integer", "minimum": 1},
    "startup_exit_code": {"type": "integer"},
    "controller_exit_code": {"type": ["integer", "null"]},
    "run": {"type": ["object", "null"]},
    "deletion_eligible": {"const": true},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
