    "output_token_ids_sha256": "c6be8f4572e015d21d0e8961218ae1d26b96e5d9289aa09f0505ff0dffbd4509",
    "raw_output": "```java\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class Solution {\n    public static List<Integer> multisetOverlap(List<Integer> left, List<Integer> right) {\n        List<Integer> result = new ArrayList<>();\n        int rightIndex = 0;\n        int rightCount = 0;\n\n        for (int leftValue : left) {\n            // Find the first unused occurrence of leftValue in right\n            while (rightIndex < rightCount && right[rightIndex] != leftValue) {\n                rightIndex++;\n            }\n\n            if (rightIndex < rightCount) {\n                // Found an unused occurrence, consume it\n                right[rightIndex] = -1; // Mark as used\n                rightIndex++;\n                result.add(leftValue);\n            }\n        }\n\n        return result;\n    }\n}\n```<|im_end|>",
