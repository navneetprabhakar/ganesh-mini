    "raw_output": "use std::cmp::Ordering;\n\npub fn bounded_prefix_sum(values: &[i64], bound: i64) -> Option<i64> {\n    let mut prefix_sum = 0i64;\n    let mut valid = true;\n\n    for &value in values {\n        prefix_sum += value;\n        if prefix_sum < bound || prefix_sum > bound {\n            valid = false;\n            break;\n        }\n    }\n\n    if valid {\n        Some(prefix_sum)\n    } else {\n        None\n    }\n}<|im_end|>",
