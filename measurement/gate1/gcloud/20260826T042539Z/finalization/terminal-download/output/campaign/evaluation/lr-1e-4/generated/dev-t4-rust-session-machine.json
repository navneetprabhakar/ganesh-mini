    "raw_output": "fn run_session(events: &[&str]) -> Option<String> {\n    let mut state: String = \"closed\".to_string();\n    for event in events {\n        match event {\n            \"open\" => {\n                if state == \"closed\" {\n                    state = \"open\".to_string();\n                } else {\n                    return None;\n                }\n            }\n            \"authenticate\" => {\n                if state == \"open\" {\n                    state = \"ready\".to_string();\n                } else {\n                    return None;\n                }\n            }\n            \"ping\" => {\n                if state == \"ready\" {\n                    state = \"ready\".to_string();\n                } else {\n                    return None;\n                }\n            }\n            \"close\" => {\n                if state == \"open\" || state == \"ready\" {\n                    state = \"closed\".to_string();\n                } else {\n                    return None;\n                }\n            }\n            _ => {\n                return None;\n            }\n        }\n    }\n    Some(state)\n}<|im_end|>",
