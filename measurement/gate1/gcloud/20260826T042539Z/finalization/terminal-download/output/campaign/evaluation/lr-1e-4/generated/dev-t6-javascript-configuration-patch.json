    "output_token_ids_sha256": "6caa72be6a13565f2bb199e44e1ee2b4f0c6003da5d719954f3b1cbbe676068a",
    "raw_output": "function patchConfig(base, patches) {\n  const result = JSON.parse(JSON.stringify(base));\n  for (const op of patches) {\n    if (op.key === undefined || op.key === '') {\n      throw new Error('empty key');\n    }\n    if (op.key in result) {\n      if (op.value === undefined) {\n        delete result[op.key];\n      } else {\n        result[op.key] = op.value;\n      }\n    } else {\n      throw new Error('unknown operation');\n    }\n  }\n  const sorted = Object.entries(result).sort((a, b) => a[0].localeCompare(b[0]));\n  return sorted.map(([k, v]) => `${k}=${v}`).join('\\n');\n}\n\nmodule.exports = { patchConfig };<|im_end|>",
