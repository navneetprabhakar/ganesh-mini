    "extracted_code": "export function rollingChecksums(values: readonly number[], window: number): number[] | null {\n  if (window <= 0) {\n    return null;\n  }\n  const out: number[] = [];\n  for (let i = 0; i + window <= values.length; i++) {\n    const windowValues = values.slice(i, i + window);\n    let sum = 0;\n    for (let j = 0; j < windowValues.length; j++) {\n      sum += windowValues[j] * (j + 1);\n    }\n    out.push(sum);\n  }\n  return out;\n}\n",
