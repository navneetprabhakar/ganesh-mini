{"assigned_cross_cutting_dimension":"immutability_and_aliasing","candidate_sha256":"a8ef39488d5c65261f73c32d4aa34d7a26560e86a347c3d300c87face51642a0","evidence_sha256":"09c383f690f55a561f1362c9c823e34ed11853dc8914f4eff5b4adda8d17651c","generic_edge_case_boilerplate_is_primary":false,"primary_capability":"associative_aggregation","primary_capability_is_substantive":true,"rationale":"The core required behavior is map-based grouping and aggregation: resolve each local name by a one-step alias lookup, merge records sharing a canonical key, and compute per-group counts and sums. The cross-cutting dimension is concrete because inputs must remain immutable and returned borrowed keys must alias storage in the inputs without allocating names.","reviewer_run_evidence_sha256":"6a06a64592d99d4be37cd5270098b225b3cd42cc05e856ef7fbf46a236fd7075","specification_sha256":"98c4e8b9bafbb575ffb74b3cf7693c20aa57bedd86ca994c291ca54121361ebc","verdict":"pass","visibility":{"evaluation_artifacts_read":0,"known_bad_visible":false,"reference_visible":false,"source_stimulus_visible":false,"specification_and_assigned_labels_only":true,"teacher_context_visible":false,"tests_visible":false,"verifier_outputs_visible":false}}
{"assigned_cross_cutting_dimension":"state_isolation","candidate_sha256":"5f1c471d3f92a969b9386075c0af56a847602ca8ea5eff6e08d3b1fe7a02957b","evidence_sha256":"108ad33e3e4397b891804a6d6b76f1a979346f9887a703b6787f5dedc3a0e862","generic_edge_case_boilerplate_is_primary":false,"primary_capability":"numeric_reasoning","primary_capability_is_substantive":true,"rationale":"The central behavior requires overflow-safe rational accumulation, quotient/remainder calculation, and limit-bounded crediting for arbitrary u64 inputs. State isolation is concretely required through independent per-channel totals and remainders, with operations on one channel forbidden from reading or modifying another channel's state.","reviewer_run_evidence_sha256":"6a06a64592d99d4be37cd5270098b225b3cd42cc05e856ef7fbf46a236fd7075","specification_sha256":"96c69583ed1355e103b6f70515afe23f0a168e58333537a71a3509405229da91","verdict":"pass","visibility":{"evaluation_artifacts_read":0,"known_bad_visible":false,"reference_visible":false,"source_stimulus_visible":false,"specification_and_assigned_labels_only":true,"teacher_context_visible":false,"tests_visible":false,"verifier_outputs_visible":false}}
