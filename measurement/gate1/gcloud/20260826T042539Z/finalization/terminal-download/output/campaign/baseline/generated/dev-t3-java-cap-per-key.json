    "output_token_ids_sha256": "ac2fc366cadd641beed88c490bb16d97571478d22c7bd887580db38abc810cd3",
    "raw_output": "```java\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class Solution {\n    public static List<Integer> capPerKey(List<String> keys, int limit) {\n        if (limit < 0) {\n            return new ArrayList<>();\n        }\n        if (keys == null || keys.isEmpty()) {\n            return new ArrayList<>();\n        }\n\n        // Map to store the count of each key seen so far\n        java.util.Map<String, Integer> keyCounts = new java.util.HashMap<>();\n        // List to store the result indices\n        List<Integer> result = new ArrayList<>();\n\n        for (int i = 0; i < keys.size(); i++) {\n            String key = keys.get(i);\n            int count = keyCounts.getOrDefault(key, 0);\n\n            if (count < limit) {\n                // Add the index to the result\n                result.add(i);\n                // Increment the count for this key\n                keyCounts.put(key, count + 1);\n            }\n        }\n\n        return result;\n    }\n}\n```<|im_end|>",
