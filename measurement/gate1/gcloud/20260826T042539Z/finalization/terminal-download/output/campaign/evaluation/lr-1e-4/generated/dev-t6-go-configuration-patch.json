    "raw_output": "package solution\n\nimport \"sort\"\n\nfunc PatchConfig(base map[string]string, patches [][3]string) ([]string, bool) {\n\tres := make(map[string]string)\n\tfor _, k := range base {\n\t\tres[k] = k\n\t}\n\tfor _, p := range patches {\n\t\top := p[0]\n\t\tif op == \"unset\" {\n\t\t\tif _, ok := res[p[1]]; ok {\n\t\t\t\tdelete(res, p[1])\n\t\t\t}\n\t\t} else if op == \"set\" {\n\t\t\tif _, ok := res[p[1]]; !ok {\n\t\t\t\tres[p[1]] = p[2]\n\t\t\t}\n\t\t}\n\t}\n\tkeys := make([]string, 0, len(res))\n\tfor k := range res {\n\t\tkeys = append(keys, k)\n\t}\n\tsort.Strings(keys)\n\tvar sb strings.Builder\n\tfor _, k := range keys {\n\t\tsb.WriteString(fmt.Sprintf(\"%s=%s\", k, res[k]))\n\t}\n\treturn []string{sb.String()}, len(res) > 0\n}<|im_end|>",
