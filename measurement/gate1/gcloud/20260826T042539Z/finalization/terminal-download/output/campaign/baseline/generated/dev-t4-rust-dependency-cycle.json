    "output_token_ids_sha256": "6d4057c49c5e09945f327e9f5e472a5c04e2e1cbe526ab57017f68f983559656",
    "raw_output": "```rust\npub fn dependencies_valid(nodes: &[&str], edges: &[(&str, &str)]) -> bool {\n    if nodes.is_empty() {\n        return true;\n    }\n\n    // 1. Check for duplicate nodes\n    let mut seen = std::collections::HashSet::new();\n    for node in nodes {\n        if !seen.insert(node.to_string()) {\n            return false;\n        }\n    }\n\n    // 2. Check for missing edges\n    for (u, v) in edges {\n        if !nodes.contains(u) || !nodes.contains(v) {\n            return false;\n        }\n    }\n\n    // 3. Check for cycles using DFS\n    let mut visited = vec![false; nodes.len()];\n    let mut rec_stack = vec![false; nodes.len()];\n    let mut has_cycle = false;\n\n    for i in 0..nodes.len() {\n        if visited[i] {\n            continue;\n        }\n\n        if dfs_cycle(nodes, edges, i, &mut visited, &mut rec_stack, &mut has_cycle) {\n            return false;\n        }\n    }\n\n    true\n}\n\nfn dfs_cycle(\n    nodes: &[&str],\n    edges: &[(&str, &str)],\n    start: usize,\n    visited: &mut [bool],\n    rec_stack: &mut [bool],\n    has_cycle: &mut bool,\n) -> bool {\n    let u = start;\n    visited[u] = true;\n    rec_stack[u] = true;\n\n    for &(v, _) in edges.iter() {\n        if v == start {\n            *has_cycle = true;\n            return true;\n        }\n        if !visited[v] {\n            if dfs_cycle(nodes, edges, v, visited, rec_stack, has_cycle) {\n                return true;\n            }\n        } else if rec_stack[v] {\n            *has_cycle = true;\n            return true;\n        }\n    }\n\n    rec_stack[u] = false;\n    false\n}\n```<|im_end|>",
