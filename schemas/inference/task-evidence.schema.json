{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganesh-mini.local/schemas/inference/task-evidence.schema.json",
  "title": "Ganesh Mini production inference task evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "run_id", "task", "model", "runtime", "prompt", "generation", "generation_sha256", "extraction", "verification", "timings_ms", "memory", "recorded_at", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-task-evidence/v2"},
    "classification": {"enum": ["private_development_baseline", "private_candidate_development", "public_diagnostic", "private_decision_final"]},
    "run_id": {"type": "string", "minLength": 1},
    "task": {"type": "object"}, "model": {"type": "object"}, "runtime": {"type": "object"}, "prompt": {"type": "object"}, "generation": {"type": "object"},
    "generation_sha256": {"$ref": "#/$defs/sha256"}, "extraction": {"type": "object"}, "verification": {"type": "object"}, "timings_ms": {"type": "object"}, "memory": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
