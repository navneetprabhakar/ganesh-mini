    "output_token_ids_sha256": "75a46570309398b7ef0a86eff239a2fbbcd492238b95fe88c6935212b045345b",
    "raw_output": "```typescript\nexport function idempotencyBatchTrace(keys: readonly string[], amounts: readonly number[]): number[] | null {\n  if (keys.length === 0) {\n    return null;\n  }\n\n  if (keys.length !== amounts.length) {\n    return null;\n  }\n\n  const result: number[] = [];\n  const seen: Map<string, number> = new Map();\n\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    const amount = amounts[i];\n\n    if (key === '') {\n      return null;\n    }\n\n    if (seen.has(key)) {\n      const prevAmount = seen.get(key)!;\n      if (prevAmount !== amount) {\n        return null;\n      }\n    } else {\n      seen.set(key, amount);\n    }\n\n    const cumulativeTotal = seen.get(key) ?? 0;\n    result.push(cumulativeTotal + amount);\n  }\n\n  return result;\n}\n```<|im_end|>",
