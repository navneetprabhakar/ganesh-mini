    "raw_output": "pub fn resolve_permissions(role: &str, parents: &[(&str, &str)], grants: &[(&str, &[&str])]) -> Option<Vec<String>> {\n    let mut result = Vec::new();\n\n    // 1. Collect named role's grants\n    if let Some(named_grants) = grants.iter().find(|(r, _)| r == role) {\n        for grant in named_grants.1 {\n            result.push(grant.to_string());\n        }\n    }\n\n    // 2. Traverse parent chain\n    let mut current = role;\n    let mut visited = std::collections::HashSet::new();\n\n    while let Some(parent) = parents.get(current) {\n        let parent_name = parent.0;\n        let parent_grants = parents.get(parent_name).map(|(p, _)| p.1);\n\n        // Reject unknown parent\n        if parent_name.is_empty() {\n            break;\n        }\n        if !parents.contains_key(parent_name) {\n            return None;\n        }\n\n        // Reject unknown role in chain\n        if !result.contains(parent_name) {\n            return None;\n        }\n\n        // Reject inheritance cycle\n        if visited.contains(parent_name) {\n            return None;\n        }\n\n        visited.insert(parent_name.clone());\n\n        // Collect parent's grants\n        if let Some(grants) = parent_grants {\n            for grant in grants {\n                result.push(grant.to_string());\n            }\n        }\n\n        current = parent_name;\n    }\n\n    // Deduplicate and sort\n    result.sort();\n    result.dedup();\n\n    Some(result)\n}<|im_end|>",
