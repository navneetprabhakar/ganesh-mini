    "output_token_ids_sha256": "aefef77a68e608aa6e3bc981dc2d33d30523540141d083ebe050fff50dbfded4",
    "raw_output": "import java.util.*;\n\npublic class Solution {\n    public static String runSession(String[] events) {\n        int state = 0; // 0: closed, 1: open, 2: ready, 3: authenticated\n        for (String e : events) {\n            switch (state) {\n                case 0: // closed\n                    if (e.equals(\"open\")) {\n                        state = 1;\n                    } else {\n                        return \"rejected\";\n                    }\n                    break;\n                case 1: // open\n                    if (e.equals(\"authenticate\")) {\n                        state = 2;\n                    } else {\n                        return \"rejected\";\n                    }\n                    break;\n                case 2: // ready\n                    if (e.equals(\"ping\")) {\n                        state = 2;\n                    } else {\n                        return \"rejected\";\n                    }\n                    break;\n                case 3: // authenticated\n                    if (e.equals(\"close\")) {\n                        state = 0;\n                    } else {\n                        return \"rejected\";\n                    }\n                    break;\n                default:\n                    return \"rejected\";\n            }\n        }\n        return String.valueOf(state);\n    }\n}<|im_end|>",
