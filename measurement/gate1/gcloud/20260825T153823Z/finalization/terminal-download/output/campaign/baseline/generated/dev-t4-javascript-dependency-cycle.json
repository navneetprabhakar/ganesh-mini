    "raw_output": "```javascript\nexports.dependenciesValid = function(nodes, edges) {\n  // Handle empty input\n  if (!nodes || nodes.length === 0) {\n    return true;\n  }\n\n  // Create a map for O(1) lookup of node names\n  const nodeMap = new Map();\n  for (const node of nodes) {\n    nodeMap.set(node, true);\n  }\n\n  // Check for duplicate node names\n  for (const node of nodes) {\n    if (!nodeMap.has(node)) {\n      return false;\n    }\n  }\n\n  // Build adjacency list and reverse adjacency list (for checking cycles)\n  const graph = new Map();\n  const reverseGraph = new Map();\n\n  for (const [node, edges] of Object.entries(edges)) {\n    if (!graph.has(node)) {\n      graph.set(node, []);\n    }\n    if (!reverseGraph.has(node)) {\n      reverseGraph.set(node, []);\n    }\n\n    for (const edge of edges) {\n      const target = edge[0];\n      const source = edge[1];\n\n      if (!graph.has(target)) {\n        graph.set(target, []);\n      }\n      if (!reverseGraph.has(source)) {\n        reverseGraph.set(source, []);\n      }\n\n      graph.get(node).push(target);\n      reverseGraph.get(target).push(source);\n    }\n  }\n\n  // Check for directed edges not declared\n  for (const [node, edges] of Object.entries(edges)) {\n    for (const edge of edges) {\n      const target = edge[0];\n      if (!graph.has(target)) {\n        return false;\n      }\n    }\n  }\n\n  // Check for cycles using DFS\n  const visited = new Set();\n  const recStack = new Set();\n\n  function hasCycle(node) {\n    visited.add(node);\n    recStack.add(node);\n\n    const neighbors = graph.get(node) || [];\n    for (const neighbor of neighbors) {\n      if (!visited.has(neighbor)) {\n        if (hasCycle(neighbor)) {\n          return true;\n        }\n      } else if (recStack.has(neighbor)) {\n        return true;\n      }\n    }\n\n    recStack.delete(node);\n    return false;\n  }\n\n  for (const node of nodes) {\n    if (!visited.has(node)) {\n      if (hasCycle(node)) {\n        return false;\n      }\n    }\n  }\n\n  return true;\n};\n```<|im_end|>",
