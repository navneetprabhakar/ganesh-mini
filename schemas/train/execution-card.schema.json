{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-training-execution-card/v1",
  "type": "object",
  "required": ["schema_version", "status", "run_id", "model", "inputs", "recipe", "budgets", "prerequisite_evidence", "card_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-training-execution-card/v1"},
    "status": {"enum": ["ready", "not_ready"]},
    "run_id": {"type": "string"},
    "model": {"type": "object"},
    "inputs": {"type": "object"},
    "recipe": {"type": "object"},
    "budgets": {"type": "object"},
    "prerequisite_evidence": {"type": "object"},
    "failed_checks": {"type": "array", "items": {"type": "string"}},
    "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
