.DS_Store
.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.gcloud-staging/

# Large or generated artifacts must live in versioned artifact storage.
models/
adapters/
checkpoints/
outputs/
datasets/cache/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Preserve small manifests and fixtures even when generated directories exist.
!models/.gitkeep
!outputs/.gitkeep

# GCloud manifests/logs are versioned; local staging and verification copies
# duplicate immutable GCS inputs and must not enter Git.
measurement/cuda/gcloud/*/preflight/staging/
measurement/cuda/gcloud/*/preflight/verified-*/
measurement/cuda/gcloud/*/runtime/checkpoints/
measurement/cuda/gcloud/*/runtime/verify-*/
measurement/cuda/gcloud/*/runtime/verified-*/
measurement/cuda/gcloud/*/terminal-predelete/verified-*/
measurement/cuda/gcloud/*/teardown/verified-*/
measurement/cuda/gcloud/*/input/workspace.tar.gz
measurement/cuda/gcloud/*/final-evidence-verified/local-run-evidence.tar.gz
measurement/cuda/gcloud/*/final-local-evidence.tar.gz
measurement/cuda/gcloud/*/*-listing.json
measurement/cuda/gcloud/*/gpu-attempt1-bulk-*/
measurement/cuda/gcloud/*/gpu-deletion-evidence/
measurement/cuda/gcloud/*/gpu-deletion-verified-*/
measurement/cuda/gcloud/*/gpu-deletion-gate-verified-*/
measurement/cuda/gcloud/*/post-delete-verified-*/
measurement/cuda/gcloud/*/post-delete/
measurement/cuda/gcloud/*/post-delete-manifest-verified-*/
measurement/cuda/gcloud/*/final-local-evidence-verified-*/
measurement/cuda/gcloud/*/final-local-evidence-manifest-verified-*/
