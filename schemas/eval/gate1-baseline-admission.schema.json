{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-gate1-baseline-admission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "attempt_id",
    "execution_sha256",
    "terminal_validation_sha256",
    "finalization_sha256",
    "post_delete_final_backup_sha256",
    "baseline_run_sha256",
    "canonical_path",
    "admitted_file_count",
    "admitted_files_sha256",
    "gate1_readiness_sha256",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ganesh-mini-gate1-baseline-admission/v1"},
    "status": {"const": "admitted"},
    "attempt_id": {"type": "string", "minLength": 1},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finalization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_delete_final_backup_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_run_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_path": {"const": "measurement/inference/development/qwen3.5-2b-base-v1"},
    "admitted_file_count": {"type": "integer", "minimum": 1},
    "admitted_files_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate1_readiness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
