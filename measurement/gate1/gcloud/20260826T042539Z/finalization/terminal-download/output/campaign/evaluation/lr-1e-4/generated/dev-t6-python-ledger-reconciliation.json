    "raw_output": "def reconcile_ledger(opening: int, entries: list[tuple[int,int,int]]) -> int | None:\n    \"\"\"Reconcile a ledger by summing signed amounts, rejecting duplicates and invalid entries.\"\"\"\n    seen_ids = set()\n    total = opening\n    for id_, kind, amount in entries:\n        if id_ in seen_ids:\n            return None\n        if kind != 1 and kind != -1:\n            return None\n        if amount <= 0:\n            return None\n        seen_ids.add(id_)\n        total += amount\n    return total<|im_end|>",
