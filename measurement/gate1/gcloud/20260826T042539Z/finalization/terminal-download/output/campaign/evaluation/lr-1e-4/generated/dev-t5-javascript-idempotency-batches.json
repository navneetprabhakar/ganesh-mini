    "raw_output": "function idempotencyBatchTrace(keys, amounts) {\n  const n = Math.min(keys.length, amounts.length);\n  if (n === 0) {\n    return null;\n  }\n  const result = new Array(n).fill(0);\n  let i = 0;\n  while (i < n) {\n    const key = keys[i];\n    if (result[key] !== undefined) {\n      result[key] += amounts[i];\n    } else {\n      result[key] = amounts[i];\n    }\n    i += 1;\n  }\n  return result;\n}\n\nmodule.exports.idempotencyBatchTrace = idempotencyBatchTrace;<|im_end|>",
