    "output_token_ids_sha256": "63df40bd4a406e08cbdcb873c11b42169d44d39ba5c988b3a7a07b5f44ffe40a",
    "raw_output": "export function resolvePermissions(role: string, parents: Record<string, string>, grants: Record<string, string[]>): string[] | null {\n  const result: string[] = [];\n  const visited = new Set<string>();\n  const queue: string[] = [];\n\n  // Handle empty parent (root)\n  if (parents[role] === \"\") {\n    return result;\n  }\n\n  // Check for unknown role\n  if (!parents[role]) {\n    return null;\n  }\n\n  // Start with the role's grants\n  const roleGrants = grants[role] || [];\n  for (const grant of roleGrants) {\n    if (visited.has(grant)) continue;\n    visited.add(grant);\n    result.push(grant);\n    queue.push(grant);\n  }\n\n  // Process queue\n  while (queue.length > 0) {\n    const parent = queue.shift()!;\n    if (visited.has(parent)) continue;\n    visited.add(parent);\n\n    // Check for unknown parent\n    if (!parents[parent]) {\n      return null;\n    }\n\n    // Collect parent's grants\n    const parentGrants = grants[parent] || [];\n    for (const grant of parentGrants) {\n      if (visited.has(grant)) continue;\n      visited.add(grant);\n      result.push(grant);\n      queue.push(grant);\n    }\n  }\n\n  // Check for inheritance cycle\n  if (visited.has(role)) {\n    return null;\n  }\n\n  return result;\n}<|im_end|>",
