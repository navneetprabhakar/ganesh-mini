    "output_token_ids_sha256": "6e1a4d919926681303fd4b46a8f8fbda8f0499acd86e6cf357d267829adfa6f0",
    "raw_output": "```typescript\nexport function ringBufferTrace(capacity: number, values: readonly number[]): number[] | null {\n  if (capacity <= 0) {\n    return null;\n  }\n  if (values.length === 0) {\n    return [];\n  }\n  if (values.some(v => v === -1)) {\n    return null;\n  }\n\n  const result: number[] = [];\n  const head = 0;\n  const tail = 0;\n  const capacityLimit = capacity;\n\n  for (const value of values) {\n    if (head === tail) {\n      // No space available, emit -1\n      result.push(-1);\n      head = (head + 1) % capacityLimit;\n      tail = (tail + 1) % capacityLimit;\n    } else {\n      // Evict oldest\n      result.push(values[head]);\n      head = (head + 1) % capacityLimit;\n    }\n  }\n\n  // Emit remaining values\n  while (head < tail) {\n    result.push(values[head]);\n    head = (head + 1) % capacityLimit;\n  }\n\n  return result;\n}\n```<|im_end|>",
