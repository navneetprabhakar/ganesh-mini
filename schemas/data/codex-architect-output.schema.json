{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problem", "reference_code", "known_bad_code", "known_bad_label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "reference_code": {"type": "string", "minLength": 1},
          "known_bad_code": {"type": "string", "minLength": 1},
          "known_bad_label": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
