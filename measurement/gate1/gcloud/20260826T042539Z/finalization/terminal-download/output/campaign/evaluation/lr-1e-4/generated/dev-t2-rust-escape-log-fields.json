    "raw_output": "pub fn escape_log_fields(fields: &[String]) -> String {\n    fields\n        .iter()\n        .map(|s| {\n            let mut res = String::new();\n            for c in s.chars() {\n                if c == '\\\\' {\n                    res.push('\\\\');\n                    res.push('\\\\');\n                } else if c == '\\t' {\n                    res.push('\\\\');\n                    res.push('t');\n                } else if c == '\\n' {\n                    res.push('\\\\');\n                    res.push('n');\n                } else if c == '\\r' {\n                    res.push('\\\\');\n                    res.push('r');\n                } else {\n                    res.push(c);\n                }\n            }\n            res\n        })\n        .collect()\n        .join(\"\\t\")\n}<|im_end|>",
