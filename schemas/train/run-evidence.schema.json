{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-sft-run/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "identities", "planned_end_row", "validation_loss_diagnostic", "save_reload", "state", "cost", "cuda", "adapter_files", "peak_rss_bytes", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-sft-run/v1"},
    "status": {"enum": ["complete", "bounded-stop"]},
    "identities": {"type": "object"},
    "planned_end_row": {"type": "integer", "minimum": 1},
    "validation_loss_diagnostic": {"type": "object", "required": ["go", "java", "javascript", "typescript", "python", "rust", "macro_mean"]},
    "save_reload": {"type": "object"},
    "state": {"type": "object"},
    "cost": {"type": "object"},
    "cuda": {"type": "object"},
    "adapter_files": {"type": "object"},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
