    "raw_output": "```javascript\n// BigInt-safe bounded prefix sum implementation\n// Returns the exact sum only when every prefix sum (including initial 0) is within [bound, bound].\n// Returns null on failure (negative bound or arithmetic overflow).\n\nconst isSafe = (val, bound) => {\n  if (bound < 0n) return null;\n  if (val < bound || val > bound) return null;\n  return val;\n};\n\nconst boundedPrefixSum = (values, bound) => {\n  if (typeof bound !== 'bigint') {\n    throw new TypeError('bound must be a bigint');\n  }\n\n  let currentSum = 0n;\n  let hasOverflow = false;\n\n  for (const val of values) {\n    if (typeof val !== 'bigint') {\n      throw new TypeError('All values must be bigint');\n    }\n\n    // Check for arithmetic overflow before adding\n    if (currentSum > 0n && currentSum + val > bound) {\n      hasOverflow = true;\n      break;\n    }\n    if (currentSum < 0n && currentSum + val < bound) {\n      hasOverflow = true;\n      break;\n    }\n\n    currentSum += val;\n  }\n\n  if (hasOverflow) return null;\n\n  // Final check: the accumulated sum must also be within bounds\n  if (currentSum < bound || currentSum > bound) {\n    return null;\n  }\n\n  return currentSum;\n};\n\n// CommonJS export\nmodule.exports.boundedPrefixSum = boundedPrefixSum;\n```<|im_end|>",
