    "raw_output": "fn decode_hex(text: &str) -> Option<Vec<u8>> {\n    let chars: Vec<char> = text.chars().collect();\n    if chars.is_empty() {\n        return Some(vec![]);\n    }\n    let mut result: Vec<u8> = Vec::new();\n    let mut i: usize = 0;\n    while i < chars.len() {\n        let c = chars[i];\n        if c < '0' || c > '9' {\n            return None;\n        }\n        if i + 1 < chars.len() && (chars[i + 1] < '0' || chars[i + 1] > '9') {\n            return None;\n        }\n        let hex = if c == 'a' || c == 'A' { 'A' as usize - 10 } else { c as usize - 48 };\n        result.push((hex << 4) as u8 | (hex as u8));\n        i += 2;\n    }\n    Some(result)\n}<|im_end|>",
