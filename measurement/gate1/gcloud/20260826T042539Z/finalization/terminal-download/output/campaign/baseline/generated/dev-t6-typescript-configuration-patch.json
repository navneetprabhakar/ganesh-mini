    "output_token_ids_sha256": "6a71b71de3b391f1098b637a63c666e2540a371ea58de17e0ed889b1e5886b2b",
    "raw_output": "```typescript\nexport function patchConfig(base: Record<string, string>, patches: Array<[string, string, string]>): string[] | null {\n  if (!base || typeof base !== 'object') {\n    return null;\n  }\n\n  const result: Record<string, string> = {};\n  const seenKeys = new Set<string>();\n\n  for (const [key, value] of Object.entries(base)) {\n    if (seenKeys.has(key)) {\n      continue;\n    }\n    seenKeys.add(key);\n    result[key] = value;\n  }\n\n  for (const [op, key, value] of patches) {\n    if (op === 'unset' && key in result) {\n      delete result[key];\n    } else if (op === 'set' && key in result) {\n      result[key] = value;\n    } else if (op === 'set' && !key in result) {\n      result[key] = value;\n    } else if (op === 'unknown') {\n      return null;\n    }\n  }\n\n  return Object.entries(result).map(([k, v]) => `${k}=${v}`).join('\\n');\n}\n```<|im_end|>",
