{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganesh-mini.local/schemas/inference/run.schema.json",
  "title": "Ganesh Mini inference run evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "classification", "status", "config_sha256",
    "model", "runtime", "task_accounting", "tasks", "started_at",
    "completed_at", "run_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "classification": {"const": "synthetic_harness_non_benchmark"},
    "status": {"enum": ["complete", "incomplete", "failed"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "model": {"type": "object"},
    "runtime": {"type": "object"},
    "task_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "completed", "passed", "failed", "pending"],
      "properties": {
        "expected": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status", "passed", "evidence_path", "evidence_sha256"],
        "properties": {
          "task_id": {"type": "string"},
          "status": {"enum": ["complete", "pending", "failed"]},
          "passed": {"type": ["boolean", "null"]},
          "evidence_path": {"type": ["string", "null"]},
          "evidence_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "run_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
