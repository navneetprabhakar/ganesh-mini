    "extracted_code": "import java.util.ArrayList;\nimport java.util.List;\n\npublic class Solution {\n    public static List<Integer> multisetOverlap(List<Integer> left, List<Integer> right) {\n        List<Integer> result = new ArrayList<>();\n        int rightIdx = 0;\n        for (int leftIdx = 0; leftIdx < left.size(); leftIdx++) {\n            int leftVal = left.get(leftIdx);\n            while (rightIdx < right.size() && right.get(rightIdx) == leftVal) {\n                result.add(leftVal);\n                rightIdx++;\n            }\n        }\n        return result;\n    }\n}\n",
