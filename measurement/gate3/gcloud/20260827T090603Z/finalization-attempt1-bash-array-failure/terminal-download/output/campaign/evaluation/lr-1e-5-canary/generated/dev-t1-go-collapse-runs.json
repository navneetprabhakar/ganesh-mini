    "raw_output": "package solution\n\nfunc CollapseRuns(values []int) []int {\n    if len(values) == 0 {\n        return []int{}\n    }\n\n    result := make([]int, 0, len(values))\n    currentRun := []int{}\n\n    for _, v := range values {\n        if len(currentRun) == 0 {\n            currentRun = append(currentRun, v)\n        } else if v == currentRun[len(currentRun)-1] {\n            currentRun = append(currentRun, v)\n        } else {\n            result = append(result, currentRun...)\n            currentRun = []int{v}\n        }\n    }\n\n    result = append(result, currentRun...)\n    return result\n}<|im_end|>",
