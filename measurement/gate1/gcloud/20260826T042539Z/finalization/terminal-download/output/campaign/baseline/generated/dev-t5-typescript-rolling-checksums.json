    "raw_output": "export function rollingChecksums(values: readonly number[], window: number): number[] | null {\n  if (window <= 0) return null;\n  const out: number[] = [];\n  for (let i = 0; i + window <= values.length; i++) {\n    const slice = values.slice(i, i + window);\n    const sum = slice.reduce((a, b) => a + b, 0);\n    const weightedSum = sum * (window + 1);\n    out.push(weightedSum);\n  }\n  return out;\n}<|im_end|>",
