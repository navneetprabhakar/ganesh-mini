{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ganesh-mini-training-checkpoint/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "step", "seen_tokens", "effective_epochs_by_lane", "checkpoint_path", "checkpoint_sha256", "config_sha256", "dataset_manifest_sha256", "created_at", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "ganesh-mini-training-checkpoint/v1"},
    "step": {"type": "integer", "minimum": 1},
    "seen_tokens": {"type": "integer", "minimum": 1},
    "effective_epochs_by_lane": {"type": "object"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
