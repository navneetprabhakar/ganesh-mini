    "raw_output": "package solution\n\nimport \"errors\"\n\nfunc CapPerKey(keys []string, limit int) ([]int, bool) {\n\tif limit < 0 {\n\t\treturn nil, false\n\t}\n\n\tif len(keys) == 0 {\n\t\treturn []int{}, true\n\t}\n\n\tresult := make([]int, 0, len(keys))\n\tseen := make(map[string]bool)\n\n\tfor i, key := range keys {\n\t\tif seen[key] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[key] = true\n\t\tresult = append(result, i)\n\t\tif len(result) >= limit {\n\t\t\tbreak\n\t\t}\n\t}\n\n\treturn result, true\n}<|im_end|>",
