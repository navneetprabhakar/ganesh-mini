    "raw_output": "package solution\n\nfunc DependenciesValid(nodes []string, edges [][2]string) bool {\n\tn := len(nodes)\n\tif n == 0 {\n\t\treturn true\n\t}\n\tif n != len(set(nodes)) {\n\t\treturn false\n\t}\n\tfor _, e := range edges {\n\t\tif !contains(nodes, e[0]) || !contains(nodes, e[1]) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn !hasCycle(nodes, edges)\n}\n\nfunc contains(nodes []string, s string) bool {\n\tfor _, n := range nodes {\n\t\tif n == s {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc set(nodes []string) map[string]bool {\n\tres := make(map[string]bool)\n\tfor _, n := range nodes {\n\t\tres[n] = true\n\t}\n\treturn res\n}\n\nfunc hasCycle(nodes []string, edges [][2]string) bool {\n\tn := len(nodes)\n\tif n == 0 {\n\t\treturn false\n\t}\n\tres := make(map[string]bool)\n\tfor _, n := range nodes {\n\t\tres[n] = false\n\t}\n\tres[nodes[0]] = true\n\tfor _, e := range edges {\n\t\tif res[e[0]] && !res[e[1]] {\n\t\t\tres[e[1]] = true\n\t\t}\n\t}\n\tfor _, e := range edges {\n\t\tif res[e[0]] && res[e[1]] {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}<|im_end|>",
