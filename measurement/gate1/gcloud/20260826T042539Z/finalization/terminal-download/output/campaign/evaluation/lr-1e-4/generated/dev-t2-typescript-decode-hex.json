    "raw_output": "function decodeHex(text: string): number[] | null {\n  const hexChars = \"0123456789abcdefABCDEF\";\n  const len = Math.min(text.length, 100);\n  const res: number[] = [];\n  for (let i = 0; i < len; i += 2) {\n    const c = text[i] === text[i].toUpperCase() ? text[i].toUpperCase() : text[i].toLowerCase();\n    if (!hexChars.includes(c)) {\n      return null;\n    }\n    const v = parseInt(text.slice(i, i + 2), 16);\n    if (v < 0 || v > 255) {\n      return null;\n    }\n    res.push(v);\n  }\n  return res.length > 0 ? res : null;\n}\n\nexport function decodeHex(text: string): number[] | null {\n  return decodeHex(text);\n}<|im_end|>",
