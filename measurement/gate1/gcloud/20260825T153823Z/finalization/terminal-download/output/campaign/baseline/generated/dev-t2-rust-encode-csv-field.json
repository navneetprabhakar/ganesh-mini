    "raw_output": "pub fn encode_csv_field(value: &str) -> String {\n    if value.contains(',') || value.contains('\"') || value.contains('\\r') || value.contains('\\n') {\n        let mut result = String::new();\n        result.push('\"');\n        for c in value.chars() {\n            match c {\n                '\"' => result.push_str(\"\\\"\\\"\"),\n                _ => result.push(c),\n            }\n        }\n        result.push('\"');\n        result\n    } else {\n        value.to_string()\n    }\n}<|im_end|>",
