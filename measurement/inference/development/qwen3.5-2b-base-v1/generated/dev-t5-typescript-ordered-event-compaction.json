    "raw_output": "export function compactOrderedEvents(seq: readonly number[], keys: readonly string[], values: readonly number[]): number[] | null {\n  if (seq.length !== keys.length || seq.length !== values.length) return null;\n  const seen = new Set<string>();\n  const result: number[] = [];\n  for (let i = 0; i < seq.length; i++) {\n    const key = keys[i];\n    if (seen.has(key)) {\n      continue;\n    }\n    seen.add(key);\n    result.push(values[i]);\n  }\n  return result.length > 0 ? result : null;\n}<|im_end|>",
