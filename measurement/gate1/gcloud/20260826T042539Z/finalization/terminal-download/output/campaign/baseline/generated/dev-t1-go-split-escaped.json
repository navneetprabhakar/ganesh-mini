    "raw_output": "package solution\n\nimport \"strings\"\n\nfunc SplitEscaped(x string) ([]string, bool) {\n\tif x == \"\" {\n\t\treturn []string{}, false\n\t}\n\n\tvar result []string\n\tvar current string\n\tinEscape := false\n\n\tfor i := 0; i < len(x); i++ {\n\t\tc := x[i]\n\n\t\tif inEscape {\n\t\t\tif c == '\\\\' {\n\t\t\t\tinEscape = false\n\t\t\t} else {\n\t\t\t\tcurrent += string(c)\n\t\t\t}\n\t\t} else if c == '\\\\' {\n\t\t\tinEscape = true\n\t\t} else if c == ',' {\n\t\t\tif inEscape {\n\t\t\t\t// Escaped comma, ignore it\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// Unescaped comma\n\t\t\tresult = append(result, current)\n\t\t\tcurrent = \"\"\n\t\t} else {\n\t\t\tcurrent += string(c)\n\t\t}\n\t}\n\n\t// Handle trailing backslash\n\tif inEscape {\n\t\t// Trailing backslash without a following character means failure\n\t\treturn nil, false\n\t}\n\n\t// Handle trailing backslash at end of string\n\tif current == \"\\\\\" {\n\t\treturn nil, false\n\t}\n\n\t// Handle trailing backslash followed by non-escape character (e.g., \\a)\n\tif current == \"\\\\\" && len(x) > i+1 && x[i+1] != '\\\\' {\n\t\treturn nil, false\n\t}\n\n\t// Final field\n\tif current != \"\" {\n\t\tresult = append(result, current)\n\t}\n\n\treturn result, true\n}<|im_end|>",
