    "extracted_code": "export function windowSummary(events: Array<[number,number]>, start: number, end: number, limit: number): [number,number] | null{\n  if (start > end || limit <= 0) return null;\n  const filtered = events.filter(([t]) => t >= start && t < end);\n  if (filtered.length === 0) return [0, 0];\n  const sorted = [...filtered].sort((a, b) => a[0] - b[0] || a[1] - b[1]);\n  const selected = sorted.slice(0, limit);\n  const count = selected.length;\n  const sum = selected.reduce((acc, [t, v]) => acc + v, 0);\n  return [count, sum];\n}\n",
