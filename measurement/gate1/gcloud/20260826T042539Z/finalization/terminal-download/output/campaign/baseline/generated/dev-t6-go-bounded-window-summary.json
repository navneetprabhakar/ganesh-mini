    "raw_output": "package solution\n\nfunc WindowSummary(events [][2]int64, start, end int64, limit int) ([2]int64, bool) {\n\tif limit <= 0 {\n\t\treturn [2]int64{0, 0}, true\n\t}\n\tif start > end {\n\t\treturn [2]int64{0, 0}, false\n\t}\n\n\tvar r [2]int64\n\tfor _, e := range events {\n\t\tif e[0] >= start && e[0] < end {\n\t\t\tif r[0] < int64(limit) {\n\t\t\t\tr[0]++\n\t\t\t\tr[1] += e[1]\n\t\t\t}\n\t\t}\n\t}\n\n\treturn r, true\n}<|im_end|>",
