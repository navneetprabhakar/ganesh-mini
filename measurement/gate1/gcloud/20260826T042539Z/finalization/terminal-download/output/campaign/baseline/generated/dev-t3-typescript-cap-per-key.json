    "raw_output": "```typescript\nexport function capPerKey(keys: readonly string[], limit: number): number[] | null {\n  if (limit < 0) {\n    return null;\n  }\n\n  if (keys.length === 0) {\n    return [];\n  }\n\n  const result: number[] = [];\n  const keyToIndexMap = new Map<string, number>();\n\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    if (!keyToIndexMap.has(key)) {\n      keyToIndexMap.set(key, i);\n    }\n    const index = keyToIndexMap.get(key)!;\n    if (result.length < limit) {\n      result.push(index);\n    }\n  }\n\n  return result.length > 0 ? result : null;\n}\n```<|im_end|>",
