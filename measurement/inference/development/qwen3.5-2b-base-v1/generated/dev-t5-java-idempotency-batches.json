    "output_token_ids_sha256": "1f6bebb8f0bfb3afbf7d9f63465e2166ad5051fc244773fe62a355a1a17cef1e",
    "raw_output": "```java\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class Solution {\n    public static List<Integer> idempotencyBatchTrace(List<String> keys, List<Integer> amounts) {\n        if (keys == null || keys.isEmpty() || amounts == null || amounts.isEmpty()) {\n            return new ArrayList<>();\n        }\n\n        int n = keys.size();\n        if (n != amounts.size()) {\n            return new ArrayList<>();\n        }\n\n        // Map to store the first amount seen for each key\n        // Key: key, Value: first amount\n        java.util.Map<String, Integer> firstAmounts = new java.util.HashMap<>();\n\n        // Result list to store cumulative totals\n        List<Integer> result = new ArrayList<>();\n\n        for (int i = 0; i < n; i++) {\n            String key = keys.get(i);\n            int amount = amounts.get(i);\n\n            if (firstAmounts.containsKey(key)) {\n                // Apply only the first amount for each key\n                firstAmounts.put(key, amount);\n            } else {\n                // First time seeing this key, store the amount\n                firstAmounts.put(key, amount);\n            }\n\n            // Emit the cumulative total after every arrival\n            int cumulativeTotal = 0;\n            for (int j = 0; j <= i; j++) {\n                cumulativeTotal += amounts.get(j);\n            }\n            result.add(cumulativeTotal);\n        }\n\n        return result;\n    }\n}\n```<|im_end|>",
