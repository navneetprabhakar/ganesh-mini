    "raw_output": "function capPerKey(keys, limit) {\n  if (limit < 0) {\n    return null;\n  }\n  const result = [];\n  const seen = new Set();\n  for (const key of keys) {\n    if (!seen.has(key)) {\n      seen.add(key);\n      result.push(key);\n      if (result.length === limit) {\n        break;\n      }\n    }\n  }\n  return result;\n}\n\nmodule.exports.capPerKey = capPerKey;<|im_end|>",
